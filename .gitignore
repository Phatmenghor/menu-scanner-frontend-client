# Yarn (Classic + Berry)
# =================================================
yarn.lock
.yarnrc
.yarnrc.yml
.yarn/install-state.gz

# Yarn Berry (ignore all by default)
.yarn/*
# If you WANT Yarn Berry reproducible installs, comment the line above
# and uncomment the lines below instead:
# !.yarn/patches
# !.yarn/plugins
# !.yarn/releases
# !.yarn/sdks
# !.yarn/versions

